# Copy to .env.local for local dev, and add the same keys in Vercel
# (Project > Settings > Environment Variables). Everything here is optional:
# missing keys just switch that feature off.

# Supabase (Project Settings > API). Server only: never prefix these with NEXT_PUBLIC_.
# Without them the server falls back to an in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password reset emails (resend.com > API Keys). Without it, reset emails are only logged.
RESEND_API_KEY=
# Sender. Must be on a domain you've verified in Resend; onboarding@resend.dev only reaches your own inbox.
EMAIL_FROM=Digly <noreply@yourdomain.com>
# Public address used in email links, e.g. https://digly.io (defaults to your Vercel production URL)
SITE_URL=
# Shown on the privacy policy and terms pages
NEXT_PUBLIC_CONTACT_EMAIL=

# Opens /api/admin/rejects?slug=<category>&key=<this>. Use 16+ random characters.
DIGLY_ADMIN_KEY=

# Sentry error tracking (sentry.io > Project Settings > Client Keys (DSN))
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces: upload source maps on build
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog usage tracking (posthog.com > Project Settings)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Later phases
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Build flags for the offline preview only (npm run build:static sets these)
DIGLY_STATIC=0
DIGLY_ASSET_PREFIX=
