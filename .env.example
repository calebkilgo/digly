# Copy to .env.local for local dev, and add the same keys in Vercel
# (Project > Settings > Environment Variables). Everything here is optional:
# missing keys just switch that feature off.

# Supabase (Project Settings > API). Server only: never prefix these with NEXT_PUBLIC_.
# Without them the server falls back to an in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Emails: password resets and email confirmations (resend.com > API Keys). Without it, emails are only logged.
RESEND_API_KEY=
# Sender. Must be on a domain you've verified in Resend; onboarding@resend.dev only reaches your own inbox.
EMAIL_FROM=Digly <noreply@yourdomain.com>
# Public address used in email links, e.g. https://digly.io (defaults to your Vercel production URL)
SITE_URL=
# Shown on the privacy policy and terms pages
NEXT_PUBLIC_CONTACT_EMAIL=
# Postal address printed in every marketing email (required by CAN-SPAM). A PO box works.
DIGLY_MAILING_ADDRESS=

# Sign in with Google (console.cloud.google.com > APIs & Services > Credentials > OAuth client ID, type Web).
# Authorized redirect URI: <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs short-lived sign-in and unsubscribe tokens. 32+ random characters. Server only.
AUTH_SECRET=
# Local dev only: fake Google sign-in at /api/auth/google?fake=sub:email (ignored in production)
DIGLY_FAKE_GOOGLE=0

# Opens /api/admin/rejects?slug=<category>&key=<this>. Use 16+ random characters.
DIGLY_ADMIN_KEY=

# Sentry error tracking (sentry.io > Project Settings > Client Keys (DSN))
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces: upload source maps on build
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog usage tracking (posthog.com > Project Settings). EU/UK visitors are asked first.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# So deleting an account also deletes its PostHog data: a personal API key with the
# person:write scope (posthog.com > Settings > Personal API keys) and the project ID. Server only.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Stripe, for Digly Unlimited (dashboard.stripe.com > Developers). Use test keys (sk_test_...) until you're ready.
STRIPE_SECRET_KEY=
# From the webhook endpoint pointing at https://digly.io/api/billing/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Optional: a Price you made in Stripe. Without it, checkout charges $5 for "Digly Unlimited".
STRIPE_PRICE_ID=

# Build flags for the offline preview only (npm run build:static sets these)
DIGLY_STATIC=0
DIGLY_ASSET_PREFIX=
